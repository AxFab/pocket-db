{
  "name": "@axfab/pocket-db",
  "version": "0.1.3",
  "description": "An embedded document database for Node.js, designed around a small file-backed storage engine.",
  "type": "module",
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/cjs/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/cjs/src",
    "docs/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/src/package.json",
    "build": "npm run build:esm && npm run build:cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "bench": "npm run build && node dist/benchmarks/bench.js",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "database",
    "embedded",
    "nosql",
    "typescript",
    "document-store",
    "append-only"
  ],
  "license": "MIT",
  "homepage": "https://pocket-db.axfab.net/",
  "repository": {
    "type": "git",
    "url": "https://github.com/AxFab/pocket-db.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/lokijs": "^1.5.14",
    "@types/node": "^20.12.0",
    "better-sqlite3": "^12.10.0",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "lokijs": "^1.5.12",
    "lowdb": "^7.0.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.61.1"
  },
  "engines": {
    "node": ">=18"
  }
}
